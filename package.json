{
  "name": "@kosmic/server",
  "version": "0.0.0",
  "description": "A production-ready Koa server with TypeScript, file-system-based routing, and modern Node.js features.",
  "keywords": [
    "koa",
    "server",
    "typescript",
    "esm",
    "routing",
    "middleware",
    "file-system-routing",
    "pino",
    "helmet"
  ],
  "homepage": "https://github.com/kosmic/server",
  "bugs": {
    "url": "https://github.com/kosmic/server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmic/server.git"
  },
  "license": "MIT",
  "author": {
    "name": "Spencer Snyder",
    "email": "sasnyde2@gmail.com",
    "url": "https://spencersnyder.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "dev": "node --watch src/index.ts",
    "lint": "xo",
    "prepare": "husky",
    "release": "np",
    "start": "node dist/src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:watch": "node --test --watch",
    "update": "ncu -i"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson"
    ]
  },
  "dependencies": {
    "@koa/etag": "^5.0.2",
    "helmet": "^8.1.0",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-conditional-get": "^3.0.0",
    "koa-passport": "^6",
    "koa-pino-logger": "^5.0.0",
    "koa-response-time": "^2.1.0",
    "koa-session": "^6.4.0",
    "koa-static": "^5.0.0",
    "path-to-regexp": "^8.3.0",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^4",
    "@types/koa-compose": "^3.2.9",
    "@types/koa-conditional-get": "^2.0.4",
    "@types/koa-passport": "^6.0.3",
    "@types/koa-pino-logger": "^3.0.5",
    "@types/koa-response-time": "^2",
    "@types/koa-session": "^6.4.5",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^25.0.6",
    "c8": "^10.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "np": "^10.2.0",
    "npm-check-updates": "latest",
    "prettier": "^3.8.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "xo": "^1.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
